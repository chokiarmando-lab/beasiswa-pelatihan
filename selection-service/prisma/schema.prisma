generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model selection {
  id            Int              @id @default(autoincrement())
  applicationId Int              @unique(map: "Selection_applicationId_key")
  institutionId Int?
  score         Float?
  notes         String?          @db.Text
  status        selection_status @default(PENDING)
  selectedAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId], map: "Selection_institutionId_idx")
  @@index([score], map: "Selection_score_idx")
  @@index([status], map: "Selection_status_idx")
}

model verification {
  id            Int                 @id @default(autoincrement())
  applicationId Int                 @unique(map: "Verification_applicationId_key")
  status        verification_status @default(PENDING)
  notes         String?             @db.Text
  verifiedBy    Int?
  verifiedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt DateTime @updatedAt

  @@index([status], map: "Verification_status_idx")
  @@index([verifiedBy], map: "Verification_verifiedBy_idx")
}

enum verification_status {
  PENDING
  VERIFIED
  REVISION
  REJECTED
}

enum selection_status {
  PENDING
  SELECTED
  NOT_SELECTED
}
